{
	"name": "@qr-plus/compress",
	"version": "1.0.0",
	"description": "QR-optimized text compression using DEFLATE + Base45 (RFC 9285). Maximizes data capacity in a single QR code.",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "pnpm run build"
	},
	"keywords": [
		"qr",
		"qrcode",
		"compression",
		"deflate",
		"base45",
		"qr-code",
		"typescript"
	],
	"author": "JRodrigoPuca",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jrodrigopuca/qr-code-generator.git",
		"directory": "packages/compress"
	},
	"bugs": {
		"url": "https://github.com/jrodrigopuca/qr-code-generator/issues"
	},
	"homepage": "https://github.com/jrodrigopuca/qr-code-generator/tree/master/packages/compress#readme",
	"engines": {
		"node": ">=18.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.19.15",
		"tsup": "^8.5.1",
		"typescript": "^6.0.2",
		"vitest": "^4.0.18"
	}
}
