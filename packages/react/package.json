{
  "name": "@qr-plus/react",
  "version": "1.0.0",
  "description": "React components and hooks for QR code generation. SVG-first, zero-config, fully typed.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "qr",
    "qrcode",
    "qr-code",
    "react",
    "svg",
    "canvas",
    "component",
    "hook",
    "generator"
  ],
  "author": "JRodrigoPuca",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrodrigopuca/qr-code-generator.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/jrodrigopuca/qr-code-generator/issues"
  },
  "homepage": "https://github.com/jrodrigopuca/qr-code-generator/tree/master/packages/react#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@qr-plus/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
