{
  "name": "qr-plus-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the @qr-plus ecosystem",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "check": "biome check",
    "check:fix": "biome check --write",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "docs": "turbo run docs",
    "clean": "turbo run clean && rm -rf node_modules",
    "e2e": "pnpm --filter @qr-plus/e2e-tests test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "tsx": "^4.21.0",
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild"
    ]
  }
}
